# === DATABASE (Neon) ===
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"  # Neon dashboard → Connection Details

# === AUTH.JS v5 ===
AUTH_SECRET="openssl rand -base64 32"        # Generate with: npx auth secret
AUTH_URL="http://localhost:3000"              # Your app URL (Vercel auto-sets in prod)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"   # Google Cloud Console → OAuth 2.0 Credentials
AUTH_GOOGLE_SECRET="your-google-client-secret"                   # Same credentials page

# === PADDLE (Sandbox) ===
PADDLE_API_KEY="pdl_sdbx_xxx"                # Paddle Sandbox → Developer Tools → API Keys
PADDLE_WEBHOOK_SECRET="pdl_ntfset_xxx"       # Paddle → Notifications → Webhook secret
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN="test_xxx"   # Paddle → Developer Tools → Client-side token
NEXT_PUBLIC_PADDLE_PRICE_MONTHLY="pri_xxx"   # Paddle → Catalog → Prices → Monthly price ID
NEXT_PUBLIC_PADDLE_PRICE_ANNUAL="pri_xxx"    # Paddle → Catalog → Prices → Annual price ID

# === VERCEL BLOB ===
BLOB_READ_WRITE_TOKEN="vercel_blob_xxx"      # Vercel Dashboard → Storage → Blob → Tokens

# === RESEND ===
RESEND_API_KEY="re_xxx"                      # Resend Dashboard → API Keys

# === ADMIN ===
ADMIN_EMAIL="you@example.com"                # Your email — gates /admin access